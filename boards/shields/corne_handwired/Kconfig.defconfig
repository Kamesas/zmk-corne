if SHIELD_CORNE_HANDWIRED_LEFT

config ZMK_KEYBOARD_NAME
    default "Corne Handwired"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_CORNE_HANDWIRED_LEFT || SHIELD_CORNE_HANDWIRED_RIGHT

config ZMK_SPLIT
    default y

endif

if SHIELD_CORNE_HANDWIRED_LEFT

config ZMK_DISPLAY
    default y

config ZMK_HID_INDICATORS
    default y

# Vertical 32x128 status screen — three 32x32 canvases (AS / layer / icon)
# drawn upright then rotated 270° onto the 128x32 framebuffer, ported from
# the nice_view canvas pattern. lv_disp_set_rotation hangs under
# LV_CONF_MINIMAL, hence canvas-level rotation.
choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

# Dedicated work queue is required: the default (system work queue) starves
# under canvas-heavy redraws.
choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

# 4096 (LVGL default under MINIMAL) silently hangs on lv_canvas_create.
# nice_view bumps to 8192 for the same reason.
config LV_Z_MEM_POOL_SIZE
    default 8192

endif

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

# ZMK_DISPLAY implies LV_CONF_MINIMAL, which strips labels, canvas, and
# fonts. Re-enable the bits the custom status widget needs.
config LV_USE_LABEL
    default y

config LV_USE_CANVAS
    default y

config LV_FONT_MONTSERRAT_14
    default y

config LV_FONT_MONTSERRAT_22
    default y

config LV_FONT_MONTSERRAT_28
    default y

choice LV_FONT_DEFAULT
    default LV_FONT_DEFAULT_MONTSERRAT_14
endchoice

endif # LVGL
