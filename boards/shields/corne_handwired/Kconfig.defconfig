if SHIELD_CORNE_HANDWIRED_LEFT

config ZMK_KEYBOARD_NAME
    default "Corne Handwired"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_CORNE_HANDWIRED_LEFT || SHIELD_CORNE_HANDWIRED_RIGHT

config ZMK_SPLIT
    default y

endif

if SHIELD_CORNE_HANDWIRED_LEFT

config ZMK_DISPLAY
    default y

choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

# Mirror what upstream nice_view does for custom screens. Default
# LV_Z_MEM_POOL_SIZE (4096) is too small — lv_label_create allocates
# internally and silently hangs the central under LV_CONF_MINIMAL.
choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

config LV_Z_MEM_POOL_SIZE
    default 8192 if ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    default 5120 if ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN

endif

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

# ZMK_DISPLAY does `imply LV_CONF_MINIMAL`, which turns off label widgets and
# fonts by default. Re-enable what the custom status screen needs.
config LV_USE_LABEL
    default y

config LV_FONT_MONTSERRAT_14
    default y

# Without an explicit default font, lv_label_create() dereferences a NULL
# font pointer at runtime and hangs the central before USB enumerates.
choice LV_FONT_DEFAULT
    default LV_FONT_DEFAULT_MONTSERRAT_14
endchoice

endif # LVGL
