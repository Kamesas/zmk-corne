if SHIELD_CORNE_HANDWIRED_LEFT

config ZMK_KEYBOARD_NAME
    default "Corne Handwired"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_CORNE_HANDWIRED_LEFT || SHIELD_CORNE_HANDWIRED_RIGHT

config ZMK_SPLIT
    default y

endif

if SHIELD_CORNE_HANDWIRED_LEFT

config ZMK_DISPLAY
    default y

# Built-in status screen — proven working on this hardware. Vertical
# rotation via lv_disp_set_rotation hangs under LV_CONF_MINIMAL, and the
# proper alternative (canvas-level rotation like nice_view) is a larger
# port. Shipping horizontal for now; revisit vertical as a follow-up if
# the user wants it.
choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN
endchoice

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

config LV_Z_MEM_POOL_SIZE
    default 5120

endif

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

# ZMK_DISPLAY implies LV_CONF_MINIMAL which strips labels and fonts.
# The upstream built-in status screen renders text/icons, so re-enable.
config LV_USE_LABEL
    default y

config LV_FONT_MONTSERRAT_14
    default y

choice LV_FONT_DEFAULT
    default LV_FONT_DEFAULT_MONTSERRAT_14
endchoice

endif # LVGL
